{
  "name": "@nextxai/cli",
  "version": "0.1.0",
  "description": "NextX in your terminal: chat with NextX AI on your workspace data, call the API, manage keys and webhooks",
  "keywords": [
    "nextx",
    "cli",
    "ai",
    "terminal",
    "api",
    "mcp"
  ],
  "homepage": "https://developers.nextx.vn/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextx-organization/nextx-cli.git"
  },
  "bugs": "https://github.com/nextx-organization/nextx-cli/issues",
  "license": "MIT",
  "author": "NextX <support@nextx.vn>",
  "type": "module",
  "bin": {
    "nextx": "dist/bin/nextx.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "commander": "14.0.3",
    "ink": "6.3.1",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "open": "10.2.0",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "smol-toml": "1.4.2",
    "undici": "7.16.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
